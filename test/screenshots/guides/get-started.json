{
  "guide": "get-started",
  "title": "Get started with the web UI",
  "world": "harbor",
  "order": 1,
  "signed_out": true,
  "steps": [
    {
      "step": "the Sign in page",
      "route": "/",
      "actions": [{ "waitFor": { "text": "Agents run as you on this machine" } }],
      "capture": { "name": "get-started-01", "clip": "window" }
    },
    {
      "step": "sign in with the passphrase",
      "actions": [
        { "fill": { "label": "Passphrase", "value": "{{passphrase}}" } },
        { "click": { "role": "button", "name": "Sign in" } },
        { "waitFor": { "text": "Nothing needs you" } }
      ],
      "capture": { "name": "get-started-02", "clip": "window" }
    },
    {
      "step": "check the worker",
      "actions": [
        { "click": { "role": "link", "name": "Workers and resources" } },
        { "waitFor": { "text": "Machines" } },
        { "waitFor": { "text": "claude-code" } }
      ],
      "capture": { "name": "get-started-03", "clip": "window" }
    },
    {
      "step": "open Autonomy and run windows",
      "actions": [
        { "click": { "role": "link", "name": "Settings" } },
        { "click": { "role": "link", "name": "Autonomy and run windows" } },
        { "waitFor": { "text": "Claims while a member has opened a run window" } },
        { "waitFor": { "text": "Read the stated risk" } }
      ],
      "capture": { "name": "get-started-04", "clip": { "selector": "main" } }
    },
    {
      "step": "read the stated risk",
      "actions": [
        { "click": { "role": "button", "name": "Read the stated risk" } },
        { "waitFor": { "text": "I stand behind it", "in": { "role": "dialog", "name": "The stated risk" } } }
      ],
      "capture": { "name": "get-started-05", "clip": { "role": "dialog", "name": "The stated risk" } }
    },
    {
      "step": "acknowledge the stated risk",
      "actions": [
        { "click": { "role": "button", "name": "I stand behind it" } },
        { "click": { "role": "link", "name": "Needs you", "in": { "role": "navigation", "name": "Views" } } },
        { "waitFor": { "text": "Nothing needs you" } }
      ]
    },
    {
      "step": "reload and see the acknowledgement",
      "route": "/projects/default/settings?section=autonomy",
      "actions": [{ "waitFor": { "text": "The stated risk is acknowledged for this worker." } }]
    },
    {
      "step": "open the command palette",
      "route": "/needs-you",
      "actions": [
        { "press": "ControlOrMeta+K" },
        { "waitFor": { "text": "Actions", "in": { "role": "dialog", "name": "Command palette" } } }
      ],
      "capture": { "name": "get-started-06", "clip": "window" }
    },
    {
      "step": "show the keyboard shortcuts",
      "actions": [
        { "press": "Escape" },
        { "press": "?" },
        { "waitFor": { "text": "Show these shortcuts", "in": { "role": "dialog", "name": "Keyboard shortcuts" } } }
      ],
      "capture": { "name": "get-started-07", "clip": { "role": "dialog", "name": "Keyboard shortcuts" } }
    }
  ]
}
