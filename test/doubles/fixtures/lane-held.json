{
  "source": "NFR-PERF-3 sizing: the turn RS1 recorded for lane_report, held after its prompt until the test writes the release file, so every lane runs at once",
  "turns": [
    [
      {
        "init": true
      },
      {
        "hook": "UserPromptSubmit",
        "input": {
          "prompt": "the brief"
        }
      },
      {
        "emit": {
          "type": "stream_event",
          "parent_tool_use_id": null,
          "event": {
            "type": "message_start",
            "message": {
              "usage": {
                "input_tokens": 3,
                "cache_creation_input_tokens": 100,
                "cache_read_input_tokens": 900,
                "output_tokens": 0
              }
            }
          }
        }
      },
      {
        "wait_file": "release"
      },
      {
        "mcp": "lane_report",
        "arguments": {
          "outcome": "completed",
          "artifacts": [
            "branch"
          ],
          "checks": [
            {
              "name": "unit",
              "passed": true
            }
          ]
        }
      },
      {
        "hook": "Stop",
        "input": {}
      },
      {
        "emit": {
          "type": "result",
          "subtype": "success",
          "is_error": false,
          "terminal_reason": "completed",
          "num_turns": 1,
          "total_cost_usd": 0.03,
          "usage": {
            "input_tokens": 3,
            "cache_creation_input_tokens": 0,
            "cache_read_input_tokens": 0,
            "output_tokens": 5
          }
        }
      }
    ]
  ]
}
